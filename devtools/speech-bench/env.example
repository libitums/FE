# 음성 벤더 비교 도구의 키 이름과 형식입니다. 값은 적지 않습니다.
# 이 파일을 저장소 밖(예: ~/.duru/speech-bench/keys.env)에 복사해 채우고 `--env-file`로 넘기세요.
# 저장소 안 경로를 주면 도구가 멈춥니다. 키가 없는 벤더는 건너뛰고 빠진 이름을 알려 줍니다.

# ── Azure Speech (azure-pron · azure-stt) ──
AZURE_SPEECH_KEY=            # Speech 리소스 키(32자 안팎의 영숫자)
AZURE_SPEECH_ENDPOINT=       # https://<리소스 이름>.cognitiveservices.azure.com  — 이것 또는 아래 지역 중 하나
AZURE_SPEECH_REGION=         # 예: koreacentral · japaneast (ENDPOINT가 없을 때만 씀)

# ── SpeechSuper (speechsuper-pron) ──
SPEECHSUPER_APP_KEY=         # appKey (applicationId)
SPEECHSUPER_SECRET_KEY=      # secretKey — 서명(SHA-1)에만 쓰고 보내지 않음
SPEECHSUPER_CORE_TYPE=       # 선택. 기본 sent.eval.kr (낱말이면 word.eval.kr, 문단이면 para.eval.kr)

# ── 네이버 CLOVA Speech 단문 인식 (clova-pron · clova-stt) ──
CLOVA_SPEECH_SECRET_KEY=     # NCP 콘솔 CLOVA Speech 도메인의 Secret Key (X-CLOVASPEECH-API-KEY 헤더 값)

# ── ElevenLabs Scribe (elevenlabs-stt) ──
ELEVENLABS_API_KEY=          # xi-api-key 헤더 값
ELEVENLABS_STT_MODEL=        # 선택. 기본 scribe_v2
ELEVENLABS_ZERO_RETENTION=   # 선택. 1이면 enable_logging=false(무보관 — 기업 계약에서만 허용)

# ── OpenAI (openai-stt) ──
OPENAI_API_KEY=              # sk-... (Bearer)
OPENAI_STT_MODEL=            # 선택. 기본 gpt-4o-transcribe (gpt-4o-mini-transcribe · whisper-1)

# ── Deepgram (deepgram-stt) ──
DEEPGRAM_API_KEY=            # Authorization: Token <값>
DEEPGRAM_MODEL=              # 선택. 기본 nova-3 (한국어가 안 되면 nova-2)
