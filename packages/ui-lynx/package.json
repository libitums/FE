{
  "name": "@libitums/ui-lynx",
  "version": "0.1.0",
  "private": true,
  "description": "libitum design-system components for ReactLynx",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/round-button/round-button.css",
    "./dist/progress-header/progress-header.css",
    "./dist/page-indicator/page-indicator.css",
    "./dist/bottom-navigator/bottom-navigator.css",
    "./dist/bottom-sheet/bottom-sheet.css",
    "./dist/step-indicator/step-indicator.css",
    "./dist/overlay/overlay.css",
    "./dist/answer-label/answer-label.css",
    "./dist/card/card.css",
    "./dist/compact-numeric-input/compact-numeric-input.css",
    "./dist/fog/fog.css",
    "./dist/chat-bubble/chat-bubble.css",
    "./dist/text-field/text-field.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./back-header": {
      "types": "./dist/back-header/index.d.ts",
      "import": "./dist/back-header/index.js",
      "default": "./dist/back-header/index.js"
    },
    "./status-indicator": {
      "types": "./dist/status-indicator/index.d.ts",
      "import": "./dist/status-indicator/index.js",
      "default": "./dist/status-indicator/index.js"
    },
    "./round-button": {
      "types": "./dist/round-button/index.d.ts",
      "import": "./dist/round-button/index.js",
      "default": "./dist/round-button/index.js"
    },
    "./round-button/styles.css": "./dist/round-button/round-button.css",
    "./progress-header": {
      "types": "./dist/progress-header/index.d.ts",
      "import": "./dist/progress-header/index.js",
      "default": "./dist/progress-header/index.js"
    },
    "./page-indicator": {
      "types": "./dist/page-indicator/index.d.ts",
      "import": "./dist/page-indicator/index.js",
      "default": "./dist/page-indicator/index.js"
    },
    "./bottom-navigator": {
      "types": "./dist/bottom-navigator/index.d.ts",
      "import": "./dist/bottom-navigator/index.js",
      "default": "./dist/bottom-navigator/index.js"
    },
    "./bottom-navigator/styles.css": "./dist/bottom-navigator/bottom-navigator.css",
    "./bottom-sheet": {
      "types": "./dist/bottom-sheet/index.d.ts",
      "import": "./dist/bottom-sheet/index.js",
      "default": "./dist/bottom-sheet/index.js"
    },
    "./bottom-sheet/styles.css": "./dist/bottom-sheet/bottom-sheet.css",
    "./step-indicator": {
      "types": "./dist/step-indicator/index.d.ts",
      "import": "./dist/step-indicator/index.js",
      "default": "./dist/step-indicator/index.js"
    },
    "./step-indicator/styles.css": "./dist/step-indicator/step-indicator.css",
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js",
      "default": "./dist/overlay/index.js"
    },
    "./overlay/styles.css": "./dist/overlay/overlay.css",
    "./answer-label": {
      "types": "./dist/answer-label/index.d.ts",
      "import": "./dist/answer-label/index.js",
      "default": "./dist/answer-label/index.js"
    },
    "./answer-label/styles.css": "./dist/answer-label/answer-label.css",
    "./card": {
      "types": "./dist/card/index.d.ts",
      "import": "./dist/card/index.js",
      "default": "./dist/card/index.js"
    },
    "./card/styles.css": "./dist/card/card.css",
    "./compact-numeric-input": {
      "types": "./dist/compact-numeric-input/index.d.ts",
      "import": "./dist/compact-numeric-input/index.js",
      "default": "./dist/compact-numeric-input/index.js"
    },
    "./compact-numeric-input/styles.css": "./dist/compact-numeric-input/compact-numeric-input.css",
    "./fog": {
      "types": "./dist/fog/index.d.ts",
      "import": "./dist/fog/index.js",
      "default": "./dist/fog/index.js"
    },
    "./fog/styles.css": "./dist/fog/fog.css",
    "./chat-bubble": {
      "types": "./dist/chat-bubble/index.d.ts",
      "import": "./dist/chat-bubble/index.js",
      "default": "./dist/chat-bubble/index.js"
    },
    "./chat-bubble/styles.css": "./dist/chat-bubble/chat-bubble.css",
    "./text-field": {
      "types": "./dist/text-field/index.d.ts",
      "import": "./dist/text-field/index.js",
      "default": "./dist/text-field/index.js"
    },
    "./text-field/styles.css": "./dist/text-field/text-field.css",
    "./styles.css": "./dist/styles.css",
    "./progress-header.css": "./dist/progress-header/progress-header.css",
    "./page-indicator.css": "./dist/page-indicator/page-indicator.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:ui && pnpm test:integration",
    "test:unit": "vitest run unit.test",
    "test:ui": "vitest run ui.test",
    "test:integration": "pnpm pack:check && vitest run index.integration.test",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --pack-destination .pack && node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@libitums/design-tokens": "0.2.0",
    "@libitums/icons": "0.2.0"
  },
  "devDependencies": {
    "@lynx-js/react": "0.125.0",
    "@lynx-js/testing-environment": "0.3.3",
    "@lynx-js/types": "4.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.123.0 <0.126.0"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
