{
  "name": "@libitums/ui-lynx",
  "version": "0.1.0",
  "private": true,
  "description": "libitum design-system components for ReactLynx",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.jsx",
  "module": "./dist/index.jsx",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./button": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./back-header": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./status-indicator": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:ui",
    "test:unit": "vitest run unit.test",
    "test:ui": "vitest run ui.test",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --pack-destination .pack && node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@libitums/design-tokens": "0.2.0",
    "@libitums/icons": "0.2.0"
  },
  "devDependencies": {
    "@lynx-js/react": "0.125.0",
    "@lynx-js/testing-environment": "0.3.3",
    "@lynx-js/types": "4.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react": "19.2.18",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.123.0 <0.126.0"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
