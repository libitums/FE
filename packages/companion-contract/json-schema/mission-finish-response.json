{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "graded"
        },
        "report": {
          "type": "object",
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "missionId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "missionVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "outcome": {
              "type": "string",
              "enum": ["success", "fail"]
            },
            "endReason": {
              "type": "string",
              "enum": ["goals", "turn_limit"]
            },
            "totalScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "taskScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "accuracyScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "expressionScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hintsUsed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "weights": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "number"
                },
                "accuracy": {
                  "type": "number"
                },
                "expression": {
                  "type": "number"
                },
                "hintPenalty": {
                  "type": "number"
                }
              },
              "required": ["task", "accuracy", "expression", "hintPenalty"],
              "additionalProperties": false
            },
            "goals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "ko": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    },
                    "required": ["en"],
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  },
                  "done": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["id", "required", "label", "done", "evidence"],
                "additionalProperties": false
              }
            },
            "expressions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z]{4}:[0-9a-f]{8}$"
                  },
                  "ko": {
                    "type": "string"
                  },
                  "meaning": {
                    "type": "string"
                  },
                  "used": {
                    "type": "boolean"
                  }
                },
                "required": ["id", "ko", "meaning", "used"],
                "additionalProperties": false
              }
            },
            "corrections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "original": {
                    "type": "string"
                  },
                  "corrected": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["correction", "better", "l1_to_ko"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["original", "corrected", "kind"],
                "additionalProperties": false
              }
            },
            "retry": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ko": {
                    "type": "string"
                  },
                  "meaning": {
                    "type": "string"
                  }
                },
                "required": ["ko", "meaning"],
                "additionalProperties": false
              }
            },
            "summary": {
              "type": "string"
            },
            "bestScore": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "graderModel": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            }
          },
          "required": [
            "conversationId",
            "missionId",
            "missionVersion",
            "outcome",
            "endReason",
            "totalScore",
            "taskScore",
            "accuracyScore",
            "expressionScore",
            "hintsUsed",
            "weights",
            "goals",
            "expressions",
            "corrections",
            "retry",
            "summary",
            "bestScore",
            "graderModel",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "required": ["status", "report"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "abandoned"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["status", "conversationId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "grading_failed"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "retryable": {
          "type": "boolean"
        },
        "refunded": {
          "type": "boolean"
        }
      },
      "required": ["status", "conversationId", "retryable", "refunded"],
      "additionalProperties": false
    }
  ]
}
