{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "none", "unavailable"]
    },
    "messageId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["speech", "action", "narration"]
          },
          "text": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          }
        },
        "required": ["kind", "text"],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string",
      "enum": ["model", "canned"]
    },
    "suggestions": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "messageId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": ["ok", "unavailable"]
            },
            "items": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": ["string", "null"]
                  },
                  "intent": {
                    "type": "string",
                    "enum": ["elaborate", "ask", "reflect", "redirect", "boundary", "progress"]
                  }
                },
                "required": ["text", "meaning", "intent"],
                "additionalProperties": false
              }
            },
            "reason": {
              "type": "string",
              "enum": ["generation_failed", "blocked", "no_valid_candidates"]
            }
          },
          "required": ["messageId", "status", "items"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "has_messages",
        "not_available",
        "age_restricted",
        "temporarily_blocked",
        "usage_time_limit",
        "turn_in_progress"
      ]
    }
  },
  "required": ["status", "messageId", "segments", "suggestions"],
  "additionalProperties": false
}
