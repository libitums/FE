{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "character_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "client_message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "text": {
      "type": "string"
    },
    "input_mode": {
      "type": "string",
      "enum": ["text", "voice"]
    },
    "client_region": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "suggestion": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": ["message_id", "index"],
      "additionalProperties": false
    },
    "from_suggestion": {
      "type": "boolean"
    }
  },
  "required": ["contract_version", "character_id", "client_message_id", "text", "input_mode"],
  "additionalProperties": false
}
