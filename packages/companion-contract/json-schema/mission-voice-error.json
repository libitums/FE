{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "method_not_allowed",
            "invalid_session",
            "invalid_request",
            "unsupported_contract_version",
            "not_available",
            "character_not_found",
            "age_restricted",
            "temporarily_blocked",
            "usage_time_limit",
            "duplicate_message",
            "turn_in_progress",
            "not_latest_message",
            "trial_exhausted",
            "insufficient_credits",
            "rate_limited",
            "server_misconfigured",
            "internal_error"
          ]
        },
        {
          "type": "string",
          "enum": [
            "mission_not_found",
            "mission_closed",
            "mission_ended",
            "mission_not_ended",
            "hint_limit",
            "no_goal_left",
            "hint_unavailable"
          ]
        },
        {
          "type": "string",
          "enum": [
            "invalid_audio",
            "audio_too_long",
            "speech_empty",
            "speech_busy",
            "speech_unavailable",
            "tts_unavailable",
            "voice_limit",
            "voice_target_not_found",
            "voice_not_configured"
          ]
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "detail": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["error", "retryable"],
  "additionalProperties": false
}
