{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "ko": {
      "type": "string",
      "minLength": 1
    },
    "roman": {
      "type": "string"
    },
    "meaning": {
      "type": "string"
    },
    "hintsLeft": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["goalId", "ko", "roman", "meaning", "hintsLeft"],
  "additionalProperties": false
}
