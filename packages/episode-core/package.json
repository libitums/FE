{
  "name": "@libitums/episode-core",
  "version": "0.0.0",
  "private": true,
  "description": "Episode content decoder, answer judging, content URLs and shuffle — pure rules shared by the app and the landing trial",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./episode": {
      "types": "./src/episode/index.ts",
      "default": "./src/episode/index.ts"
    },
    "./lines": {
      "types": "./src/episode/lines.ts",
      "default": "./src/episode/lines.ts"
    },
    "./judge": {
      "types": "./src/judge/index.ts",
      "default": "./src/judge/index.ts"
    },
    "./content-url": {
      "types": "./src/content-url/index.ts",
      "default": "./src/content-url/index.ts"
    },
    "./shuffle": {
      "types": "./src/shuffle/index.ts",
      "default": "./src/shuffle/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run unit.test"
  },
  "dependencies": {
    "background-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
