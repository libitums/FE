{
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @libitums/mobile dev",
    "build": "pnpm --filter @libitums/mobile build",
    "bundle:host": "pnpm build && cp apps/mobile/dist/main.lynx.bundle apps/ios/main.lynx.bundle",
    "preview": "pnpm --filter @libitums/mobile preview",
    "typecheck": "pnpm --filter @libitums/mobile typecheck",
    "test": "pnpm --filter @libitums/mobile test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt . '!**/*.md' '!apps/ios/**'",
    "format:check": "oxfmt --check . '!**/*.md' '!apps/ios/**'",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "pnpm@10.34.5"
}
