{
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @libitums/mobile dev",
    "build": "pnpm --filter @libitums/mobile build",
    "preview": "pnpm --filter @libitums/mobile preview",
    "typecheck": "pnpm --filter @libitums/mobile typecheck",
    "test": "pnpm --filter @libitums/mobile test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  }
}
