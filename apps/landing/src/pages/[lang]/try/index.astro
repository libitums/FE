---
import { contentBaseUrl } from "@libitums/episode-core/content-url";

import TrialPage from "../../../components/trial/TrialPage.astro";
import { resolveMeasurementId } from "../../../analytics/gtag";
import { deployEnvironment } from "../../../seo/deploy-env";
import { loadTrialModel } from "../../../trial/trial-content";
import { trialImageUrlOf } from "../../../trial/trial-images";
import { resolvePreregConfig } from "../../../trial/trial-prereg";
import { type Language, defaultLanguage, languages } from "../../../site";

// 기본 언어는 src/pages/try/index.astro(`/try/`)가 그리고, 나머지 언어는 여기서 `/<코드>/try/`로 나옵니다.
export function getStaticPaths() {
  return languages
    .filter((language) => language !== defaultLanguage)
    .map((language) => ({ params: { lang: language }, props: { language } }));
}

interface Props {
  language: Language;
}

const { language } = Astro.props;
// 화면 모델은 빌드 때 사본에서 한 번 만듭니다. 음성 주소의 모양은 astro.config가 먼저 검사합니다.
// 프리뷰 배포는 방문을 세지 않습니다.
const { indexable } = deployEnvironment(process.env);
const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL ?? "").trim();
const model = loadTrialModel({
  imageUrlOf: trialImageUrlOf,
  contentBase: supabaseUrl === "" ? "" : contentBaseUrl(supabaseUrl),
});
// 사전 등록 보낼 곳(공개 키) — 프로덕션 검사는 astro.config가 먼저 했고, 없으면 폼이 unavailable입니다.
const prereg = resolvePreregConfig(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  false,
);
const measurementId = indexable
  ? resolveMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID)
  : "";
---

<TrialPage language={language} model={model} measurementId={measurementId} prereg={prereg} />
