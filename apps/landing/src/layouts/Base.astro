---
// 서체는 패키지에서 가져와 산출물에 함께 싣습니다(다른 호스트로 요청하지 않습니다).
// Pretendard는 글자 범위별 조각이라 화면에 쓰인 글자의 조각만 내려받습니다.
import "@fontsource-variable/jost/wght.css";
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
// 베트남어 페이지만 쓰는 서체(base.css의 `html[lang="vi"]`). Jost · Pretendard에 베트남어 글자가 없어서다 —
// 강조는 앱과 같은 League Spartan(ADR-0091 D5), 본문은 Pretendard의 바탕인 Inter. 다른 언어 페이지는 요청하지 않는다(unicode-range).
import "@fontsource-variable/league-spartan/wght.css";
import "@fontsource-variable/inter/wght.css";
// 일본어 페이지만 쓰는 서체(base.css의 `html[lang="ja"]`) — Jost · Pretendard에 신자체 한자가 없다(ADR-0097). 스페인어 본문은 위 Inter를 다시 쓴다.
import "@fontsource-variable/noto-sans-jp/wght.css";
import "@libitums/design-tokens/css/variables.css";
import "@libitums/design-tokens/css/typography.css";
import "../styles/base.css";
import "../styles/sections.css";
import "../styles/showcase.css";
import "../styles/phone.css";

import type { BaseProps } from "../components/landing.contract";
import { buildIconLinks } from "../seo/icon-links";
import { pages, siteName, webManifestPath } from "../site";

type Props = BaseProps;

const { language, title, description, robots } = Astro.props;
const page = pages[language];
// 아이콘은 배포 주소가 있으면 절대 주소로 냅니다 — 검색 결과의 파비콘이 이 링크를 따라갑니다.
const icons = buildIconLinks(Astro.site?.origin ?? "");
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F46B18" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="manifest" href={webManifestPath} />
    {icons.map((icon) => <link rel={icon.rel} href={icon.href} type={icon.type} sizes={icon.sizes} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{page.copy.skip}</a>
    <slot />
  </body>
</html>
