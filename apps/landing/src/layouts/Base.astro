---
// 서체는 패키지에서 가져와 산출물에 함께 싣습니다(다른 호스트로 요청하지 않습니다).
// Pretendard는 글자 범위별 조각이라 화면에 쓰인 글자의 조각만 내려받습니다.
import "@fontsource-variable/jost/wght.css";
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@libitums/design-tokens/css/variables.css";
import "@libitums/design-tokens/css/typography.css";
import "../styles/base.css";
import "../styles/sections.css";
import "../styles/showcase.css";
import "../styles/phone.css";

import type { BaseProps } from "../components/landing.contract";
import { pages } from "../site";

type Props = BaseProps;

const { language, title, description, robots } = Astro.props;
const page = pages[language];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F46B18" />
    <link rel="icon" type="image/png" href="/icon-64.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{page.copy.skip}</a>
    <slot />
  </body>
</html>
