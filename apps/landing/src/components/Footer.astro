---
import { legalDocumentIds, legalLanguageFor, legalPathFor } from "../legal/legal-paths";
import { brandProfiles, pathFor } from "../site";
import type { FooterProps } from "./landing.contract";

type Props = FooterProps;

const { language, t, variant = "landing" } = Astro.props;
const home = variant === "page" ? pathFor(language) : "#top";
// 법률 문서는 우리 주소에 있습니다(ADR-0167). 번역본이 없는 언어는 영어 기준본으로 갑니다.
const legalLanguage = legalLanguageFor(language);
const legalLabels = { terms: t.footerTerms, privacy: t.footerPrivacy };
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="brand brand--footer" href={home} data-testid="footer-brand">
      <img src="/logo-duru.webp" alt="Duru" width="69" height="26" />
    </a>
    <ul class="site-footer__links" data-testid="footer-legal">
      {
        legalDocumentIds.map((id) => (
          <li>
            <a href={legalPathFor(id, legalLanguage)} hreflang={legalLanguage}>
              {legalLabels[id]}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="site-footer__links site-footer__social" data-testid="footer-social">
      {
        brandProfiles.map((profile) => (
          <li>
            <a href={profile.url} target="_blank" rel="me noopener noreferrer">
              {profile.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="site-footer__copy">© 2026 Duru</p>
  </div>
</footer>
