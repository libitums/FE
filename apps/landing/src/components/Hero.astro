---
import type { Copy } from "../i18n/copy";
import { img } from "../assets/images";
import { type Language, trialPathFor } from "../site";

interface Props {
  language: Language;
  t: Copy;
}

const { language, t } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__panels" aria-hidden="true">
      <figure class="hero__panel" data-panel="0">
        <img src={img.heroSky.src} alt={t.heroSkyAlt} width="864" height="1536" fetchpriority="high" />
        <figcaption><b>01</b> <span>{t.panel1}</span></figcaption>
      </figure>
      <figure class="hero__panel" data-panel="1">
        <img src={img.heroCafe.src} alt={t.heroCafeAlt} width="864" height="1536" loading="lazy" />
        <figcaption><b>02</b> <span>{t.panel2}</span></figcaption>
      </figure>
      <figure class="hero__panel" data-panel="2">
        <img src={img.heroMarket.src} alt={t.heroMarketAlt} width="864" height="1536" loading="lazy" />
        <figcaption><b>03</b> <span>{t.panel3}</span></figcaption>
      </figure>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__copy container">
      <h1 class="hero__line hero__line--a" id="hero-title" set:html={t.heroA} />
      <p class="hero__line hero__line--b" set:html={t.heroB} />
      <a
        class="button hero__trial"
        href={trialPathFor(language)}
        data-trial-link="hero"
        data-testid="hero-trial-link"
      >
        {t.trialCta}
      </a>
    </div>
    <a class="hero__cue" href="#manifesto">{t.heroCue}</a>
  </div>
</section>
