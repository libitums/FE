---
import type { HeaderProps } from "./landing.contract";
import { type Language, languages, pages, pathFor } from "../site";

type Props = HeaderProps;

const { language, t, variant = "landing" } = Astro.props;
const plain = variant === "page";
const home = pathFor(language);
---

<header class:list={["site-header", { "is-solid": plain, "site-header--plain": plain }]} id="site-header">
  <div class="site-header__inner">
    <a class="brand" href={plain ? home : "#top"}>
      <img src="/logo-duru.webp" alt="Duru" width="80" height="30" />
    </a>
    {
      !plain && (
        <nav class="site-nav" aria-label={t.navLabel}>
          <a href="#ways">{t.navWays}</a>
          <a href="#journey">{t.navJourney}</a>
          <a href="#words">{t.navWords}</a>
          <a href="#faq">{t.navFaq}</a>
        </nav>
      )
    }
    <div class="site-header__actions">
      {
        !plain && (
        <details class="lang-menu">
          <summary aria-label={`${t.languageLabel}: ${pages[language].label}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3c2.6 2.5 4 5.6 4 9s-1.4 6.5-4 9c-2.6-2.5-4-5.6-4-9s1.4-6.5 4-9z"
              ></path>
            </svg>
            <span>{pages[language].label}</span>
            <svg class="lang-menu__chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </summary>
          <ul>
            {
              languages.map((code) => (
                <li>
                  <a
                    href={pathFor(code)}
                    lang={code}
                    hreflang={code}
                    aria-current={code === language ? "page" : undefined}
                  >
                    {pages[code].label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        )
      }
      <a class="button button--small" href={plain ? `${home}#download` : "#download"}>{t.navCta}</a>
    </div>
  </div>
</header>
