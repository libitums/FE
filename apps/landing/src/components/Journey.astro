---
import { Image } from "astro:assets";

import type { Copy } from "../i18n/copy";
import type { Language } from "../site";
import { storyEpisodes } from "../story/episodes";

interface Props {
  language: Language;
  t: Copy;
}

const { language, t } = Astro.props;
const two = (n: number) => String(n).padStart(2, "0");
// 카드는 그림과 번호만 보입니다. 때 · 제목 · 티저는 그림 위의 숨김 층(`scene__reveal`)에 있고,
// 호버 · 포커스로 비치거나 단추를 눌러 엽니다(`main.ts`의 `initPeek`).
---

<section class="journey" id="journey" aria-labelledby="journey-title">
  <div class="container journey__head">
    <div>
      <p class="eyebrow">{t.journeyEyebrow}</p>
      <h2 id="journey-title" set:html={t.journeyTitle} />
      <p class="section-lead">{t.journeyLead}</p>
    </div>
    <div class="rail-buttons">
      <button type="button" data-rail="-1" aria-label={t.railPrev}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button type="button" data-rail="1" aria-label={t.railNext}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
  <ol class="journey__rail" id="journey-rail" tabindex="0" aria-labelledby="journey-title">
    {
      storyEpisodes.map((episode, index) => (
        <li class:list={["scene", { "scene--new": index === 0 }]} data-episode={episode.id}>
          <button
            type="button"
            class="scene__peek"
            aria-expanded="false"
            aria-controls={`${episode.id}-peek`}
          >
            <Image
              src={episode.image}
              alt={episode.alt[language]}
              widths={[320, 480, 640]}
              sizes="(max-width: 760px) 72vw, 320px"
              style={episode.focus ? `object-position: ${episode.focus}` : undefined}
            />
            <span class="scene__no">
              {index === 0 && <span class="scene__new">{t.journeyNew}</span>}
              <span>{two(episode.number)}</span>
            </span>
          </button>
          <div class="scene__reveal" id={`${episode.id}-peek`}>
            <p class="scene__when">{episode.when[language]}</p>
            <h3>{episode.title[language]}</h3>
            <p class="scene__desc">{episode.teaser[language]}</p>
          </div>
        </li>
      ))
    }
    <li class="scene scene--more">
      <div class="scene__placeholder">
        <h3>{t.moreTitle}</h3>
        <p class="scene__desc">{t.moreDesc}</p>
      </div>
    </li>
  </ol>
</section>
