---
// Episode clear — 앱 EpisodeBannerScreen처럼 검은 면에 주황 한 줄(유지 시간 · 탭), 그 뒤 다음 이야기 예고.
// 예고 글은 컷과 같은 불투명 대사 상자 위에 둡니다(밝은 그림 위에서도 AA).
// 배너 글은 단계 제목(h2)이고, 그 위를 덮는 버튼이 탭을 받습니다(제목을 버튼 안에 두지 않음 — 버튼 안에는 제목이 올 수 없다).
import type { TrialClearProps } from "./trial-components.contract";

type Props = TrialClearProps;

const { t, imageUrl } = Astro.props;
---

<section
  class="trial-step trial-clear"
  data-testid="trial-step-clear"
  data-phase="banner"
  aria-labelledby="trial-heading-clear"
  hidden
>
  <div class="trial-clear__banner">
    <h2
      class="trial-clear__title trial-type-accent-display"
      id="trial-heading-clear"
      lang="en"
      data-step-heading
      tabindex="-1"
      data-testid="trial-clear-title"
    >
      {t.clearTitle}
    </h2>
    <button
      class="trial-clear__skip"
      type="button"
      aria-label={t.continue}
      data-testid="trial-clear-banner"
    ></button>
  </div>
  <div class="trial-clear__teaser trial-scene" data-testid="trial-clear-teaser" hidden>
    {
      imageUrl !== null && (
        <img class="trial-scene__image" src={imageUrl} alt="" data-testid="trial-clear-image" />
      )
    }
    <div class="trial-scene__bottom">
      <p class="trial-chip trial-type-label-m">{t.teaserLabel}</p>
      <div class="trial-dialog trial-clear__teaser-box">
        <h3
          class="trial-clear__teaser-title trial-type-heading-l"
          tabindex="-1"
          data-testid="trial-clear-teaser-title"
        >
          {t.teaserTitle}
        </h3>
        <p class="trial-clear__teaser-body trial-type-body-m">{t.teaserBody}</p>
      </div>
      <button class="trial-button" type="button" data-testid="trial-clear-next">{t.next}</button>
    </div>
  </div>
</section>
