---
// Episode clear 배너 — 앱 EpisodeBannerScreen처럼 검은 면에 주황 한 줄(유지 시간 · 탭). 끝나면 곧바로 완료(사전 등록)입니다.
// 배너 글은 단계 제목(h2)이고, 그 위를 덮는 버튼이 탭을 받습니다(제목을 버튼 안에 두지 않음 — 버튼 안에는 제목이 올 수 없다).
import type { TrialClearProps } from "./trial-components.contract";

type Props = TrialClearProps;

const { t } = Astro.props;
---

<section
  class="trial-step trial-clear"
  data-testid="trial-step-clear"
  aria-labelledby="trial-heading-clear"
  hidden
>
  <div class="trial-clear__banner">
    <h2
      class="trial-clear__title trial-type-accent-display"
      id="trial-heading-clear"
      lang="en"
      data-step-heading
      tabindex="-1"
      data-testid="trial-clear-title"
    >
      {t.clearTitle}
    </h2>
    <button
      class="trial-clear__skip"
      type="button"
      aria-label={t.continue}
      data-testid="trial-clear-banner"
    ></button>
  </div>
</section>
