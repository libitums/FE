---
import { buildHeadMeta } from "../seo/head-meta";
import { buildStructuredData, serializeStructuredData } from "../seo/structured-data";
import { languageRoutes, pages, siteName } from "../site";
import type { SeoHeadProps } from "./landing.contract";

type Props = SeoHeadProps;

const { language, siteUrl, faq } = Astro.props;
const page = pages[language];
const route = languageRoutes.find((candidate) => candidate.language === language);
const { ogLocale, ogLocaleAlternates, absolute } = buildHeadMeta({
  siteUrl,
  language,
  routes: languageRoutes,
  imagePath: page.image,
});
const structured = serializeStructuredData(
  buildStructuredData({
    siteUrl,
    language,
    path: route?.path ?? "/",
    name: siteName,
    description: page.description,
    faq,
  }),
);
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
<meta property="og:title" content={page.title} />
<meta property="og:description" content={page.description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={page.title} />
<meta name="twitter:description" content={page.description} />
{
  absolute && (
    <>
      <link rel="canonical" href={absolute.canonical} />
      <meta property="og:url" content={absolute.canonical} />
      {absolute.alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))}
      <meta property="og:image" content={absolute.imageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={page.imageAlt} />
      <meta name="twitter:image" content={absolute.imageUrl} />
      <meta name="twitter:image:alt" content={page.imageAlt} />
    </>
  )
}
<script type="application/ld+json" set:html={structured} />
