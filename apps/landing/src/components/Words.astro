---
import { getImage } from "astro:assets";

import { img } from "../assets/images";
import type { Copy } from "../i18n/copy";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
// 92px 정사각형에 들어가는 그림이라 작게 구운 것으로 충분합니다(원본은 세로 9:16, 가운데를 자릅니다).
const small = async (image: ImageMetadata) => (await getImage({ src: image, width: 184 })).src;
// 표현 · 로마자는 앱이 학습자에게 보여 주는 그대로이고, 뜻풀이는 페이지 언어를 따릅니다(`t.word…Gloss`).
const phrases = [
  { ko: "안녕하세요", roman: "annyeonghaseyo", gloss: t.wordHelloGloss, image: await small(img.wordHello), alt: t.wordHelloAlt },
  { ko: "물 주세요", roman: "mul juseyo", gloss: t.wordWaterGloss, image: await small(img.wordWater), alt: t.wordWaterAlt },
  {
    ko: "내일 만나요",
    roman: "naeil mannayo",
    gloss: t.wordTomorrowGloss,
    image: await small(img.wordTomorrow),
    alt: t.wordTomorrowAlt,
  },
];
---

<section class="words" id="words" aria-labelledby="words-title">
  <div class="container words__grid">
    <header class="words__head">
      <p class="eyebrow">{t.wordsEyebrow}</p>
      <h2 id="words-title" set:html={t.wordsTitle} />
    </header>
    <ul class="words__list">
      {
        phrases.map((phrase) => (
          <li class="word">
            <img src={phrase.image} alt={phrase.alt} aria-hidden="true" loading="lazy" />
            <div>
              <p class="word__ko" lang="ko">
                {phrase.ko}
              </p>
              <p class="word__gloss">
                <span class="word__roman">{phrase.roman}</span>
                {phrase.gloss}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
