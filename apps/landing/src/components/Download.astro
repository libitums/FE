---
import type { Copy } from "../i18n/copy";
import { storeLinks } from "../site";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const stores = [
  { platform: "iPhone", name: "App Store", href: storeLinks.ios },
  { platform: "Android", name: "Google Play", href: storeLinks.android },
];
---

<section class="download" id="download" aria-labelledby="download-title">
  <div class="container">
    <h2 id="download-title">{t.downloadTitle}</h2>
    <div class="download__grid">
      {
        stores.map((store) =>
          store.href ? (
            <a class="store" href={store.href} target="_blank" rel="noopener">
              <span class="store__platform">{store.platform}</span>
              <span class="store__name">{store.name}</span>
              <span class="store__state">{t.storeGet}</span>
            </a>
          ) : (
            <div class="store">
              <span class="store__platform">{store.platform}</span>
              <span class="store__name">{store.name}</span>
              <span class="store__state">{t.storeSoon}</span>
            </div>
          ),
        )
      }
    </div>
  </div>
</section>
