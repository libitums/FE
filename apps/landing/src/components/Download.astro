---
import type { Copy } from "../i18n/copy";
import { type Language, storeLinks, trialPathFor } from "../site";

interface Props {
  language: Language;
  t: Copy;
}

const { language, t } = Astro.props;
const stores = [
  { id: "ios", platform: "iPhone", name: "App Store", href: storeLinks.ios },
  { id: "android", platform: "Android", name: "Google Play", href: storeLinks.android },
];
---

<section class="download" id="download" aria-labelledby="download-title">
  <div class="container">
    <h2 id="download-title">{t.downloadTitle}</h2>
    <div class="download__grid">
      {
        stores.map((store) =>
          store.href ? (
            <a
              class="store"
              href={store.href}
              target="_blank"
              rel="noopener noreferrer"
              data-store={store.id}
              data-testid="store"
            >
              <span class="store__platform">{store.platform}</span>
              <span class="store__name">{store.name}</span>
              <span class="store__state" data-testid="store-state">{t.storeGet}</span>
            </a>
          ) : (
            <div class="store" data-testid="store">
              <span class="store__platform">{store.platform}</span>
              <span class="store__name">{store.name}</span>
              <span class="store__state" data-testid="store-state">{t.storeSoon}</span>
            </div>
          ),
        )
      }
    </div>
    <a
      class="download__trial"
      href={trialPathFor(language)}
      data-trial-link="download"
      data-testid="download-trial-link"
    >
      {t.trialDownload}
    </a>
  </div>
</section>
