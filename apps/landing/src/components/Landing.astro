---
import { resolveMeasurementId } from "../analytics/gtag";
import { img } from "../assets/images";
import Base from "../layouts/Base.astro";
import { robotsIndexable } from "../seo/head-meta";
import { buildFaq, storeAvailabilityOf } from "../seo/faq";
import { type Language, pages, storeLinks } from "../site";
import Analytics from "./Analytics.astro";
import Closing from "./Closing.astro";
import Download from "./Download.astro";
import Faq from "./Faq.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Journey from "./Journey.astro";
import Manifesto from "./Manifesto.astro";
import SeoHead from "./SeoHead.astro";
import Words from "./Words.astro";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const page = pages[language];
const t = page.copy;
const faq = buildFaq({ copy: t, storeAvailability: storeAvailabilityOf(storeLinks) });
---

<Base
  language={language}
  title={page.title}
  description={page.description}
  robots={robotsIndexable}
>
  <Fragment slot="head">
    <SeoHead language={language} siteUrl={Astro.site?.origin ?? ""} faq={faq} />
    <link rel="preload" as="image" href={img.scenePlane.src} fetchpriority="high" />
    <Analytics measurementId={resolveMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID)} />
  </Fragment>
  <Header language={language} t={t} />
  <main id="main">
    <Hero t={t} />
    <Manifesto t={t} />
    <Features t={t} />
    <Journey t={t} />
    <Words t={t} />
    <Faq t={t} entries={faq} />
    <Closing />
    <Download t={t} />
  </main>
  <Footer language={language} t={t} />
  <script>
    import "../scripts/main";
  </script>
</Base>
