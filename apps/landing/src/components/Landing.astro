---
import VercelAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { resolveMeasurementId } from "../analytics/gtag";
import { img } from "../assets/images";
import Base from "../layouts/Base.astro";
import { deployEnvironment, loadsVercelInsights } from "../seo/deploy-env";
import { robotsIndexable, robotsNoindex } from "../seo/head-meta";
import { buildFaq, storeAvailabilityOf } from "../seo/faq";
import { type Language, pages, storeLinks } from "../site";
import Analytics from "./Analytics.astro";
import Closing from "./Closing.astro";
import Download from "./Download.astro";
import Faq from "./Faq.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Journey from "./Journey.astro";
import Manifesto from "./Manifesto.astro";
import SeoHead from "./SeoHead.astro";
import Words from "./Words.astro";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const page = pages[language];
const t = page.copy;
// 프리뷰 배포는 검색에 싣지 않고 방문도 세지 않습니다.
const { indexable } = deployEnvironment(process.env);
// 쿠키 없는 방문 수(Web Analytics)와 실제 방문자의 페이지 속도(Speed Insights)는 Vercel 프로덕션 배포에서만 잽니다.
// GA4는 동의 전 저장을 막고 광고 차단기에 걸려 적게 세므로, 방문 수의 기준은 이쪽입니다.
const vercelInsights = loadsVercelInsights(process.env);
const faq = buildFaq({ copy: t, storeAvailability: storeAvailabilityOf(storeLinks) });
---

<Base
  language={language}
  title={page.title}
  description={page.description}
  robots={indexable ? robotsIndexable : robotsNoindex}
>
  <Fragment slot="head">
    <SeoHead language={language} siteUrl={Astro.site?.origin ?? ""} faq={faq} />
    <link rel="preload" as="image" href={img.heroSky.src} fetchpriority="high" />
    <Analytics
      measurementId={indexable ? resolveMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID) : ""}
    />
  </Fragment>
  <Header language={language} t={t} />
  <main id="main">
    <Hero language={language} t={t} />
    <Manifesto t={t} />
    <Features t={t} />
    <Journey language={language} t={t} />
    <Words t={t} />
    <Faq t={t} entries={faq} />
    <Closing t={t} />
    <Download language={language} t={t} />
  </main>
  <Footer language={language} t={t} />
  {
    vercelInsights && (
      <>
        <VercelAnalytics />
        <SpeedInsights />
      </>
    )
  }
  <script>
    import "../scripts/main";
  </script>
</Base>
