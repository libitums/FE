---
import { img } from "../assets/images";
import type { Copy } from "../i18n/copy";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="closing" aria-labelledby="closing-quote">
  <div class="container closing__grid">
    <div class="closing__art">
      <img src={img.sceneDescent.src} alt={t.sceneDescentAlt} aria-hidden="true" loading="lazy" />
    </div>
    <blockquote class="closing__quote">
      <p id="closing-quote" lang="ko">안녕하세요.<br />이제, 나의 이야기가 시작된다.</p>
      <footer>Hello. This is where my story begins.</footer>
    </blockquote>
  </div>
</section>
