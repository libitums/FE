 "post_cuts": [
  {
   "index": 1,
   "kind": "post",
   "cut_kind": "narration",
   "narration": {
    "ko": "창밖으로 바다와 도시가 보인다. 곧 인천에 도착한다는 안내방송이 흐른다.",
    "roman": "changbakkeuro badawa dosiga boinda. got incheone dochakandaneun annaebangsongi heureunda.",
    "en": "The sea and a city appear outside the window. An announcement says we'll land in Incheon soon."
   },
   "image_brief": "창밖으로 바다와 섬, 해안 도시가 가까워진다.",
   "image_url": "content/images/u00-tutorial/post-1.webp",
   "audio_url": ""
  },
  {
   "index": 2,
   "kind": "post",
   "cut_kind": "speech",
   "speaker": "승무원",
   "line": {
    "ko": "안녕히 가세요.",
    "roman": "annyeonghi gaseyo.",
    "en": "Goodbye."
   },
   "aside": {
    "ko": "문 앞에서 고개를 숙이며",
    "roman": "mun apeseo gogaereul sugimyeo",
    "en": "Bowing at the door."
   },
   "image_brief": "열린 비행기 문 앞에서 승무원이 고개 숙여 인사한다.",
   "image_url": "content/images/u00-tutorial/post-2.webp",
   "audio_url": ""
  },
  {
   "index": 3,
   "kind": "post",
   "cut_kind": "monologue",
   "speaker": "플레이어",
   "line": {
    "ko": "꿈은 벌써 희미하다. 그래도 그 목소리는 남아 있다. 다음에 또… 누구였을까?",
    "roman": "kkumeun beolsseo huimihada. geuraedo geu moksorineun nama itda. daeume tto… nuguyeosseulkka?",
    "en": "The dream is already fading. But that voice stays. Next time… who was it?"
   },
   "image_brief": "입국장으로 이어지는 긴 통로.",
   "image_url": "content/images/u00-tutorial/post-3.webp",
   "audio_url": ""
  },
  {
   "index": 4,
   "kind": "post",
   "cut_kind": "monologue",
   "speaker": "플레이어",
   "line": {
    "ko": "여행은 이제 시작이다. 먼저 익선동 숙소부터 가 볼까?",
    "roman": "yeohaengeun ije sijagida. meonjeo ikseondong suksobuteo ga bolkka?",
    "en": "The trip starts now. Guesthouse in Ikseon-dong first?"
   },
   "image_brief": "공항 밖, 봄 하늘 아래 공항버스 정류장.",
   "image_url": "content/images/u00-tutorial/post-4.webp",
   "audio_url": ""
  }
 ],
