 "pre_cuts": [
  {
   "index": 1,
   "kind": "pre",
   "cut_kind": "monologue",
   "speaker": "플레이어",
   "line": {
    "ko": "화면에서만 보던 나라, 한국. 일주일 동안 어떤 일이 생길까?",
    "roman": "hwamyeoneseoman bodeon nara, hanguk. iljuil dongan eotteon iri saenggilkka?",
    "en": "Korea, a country I've only seen on screens. What will this week bring?"
   },
   "image_brief": "비행기 창 너머로 구름이 흘러간다.",
   "image_url": "content/images/u00-tutorial/pre-1.webp",
   "audio_url": ""
  },
  {
   "index": 2,
   "kind": "pre",
   "cut_kind": "monologue",
   "speaker": "플레이어",
   "line": {
    "ko": "내가 아는 한국어는 드라마에서 들은 몇 마디뿐. 대박, 사랑해요, 화이팅…",
    "roman": "naega aneun hangugeoneun deuramaeseo deureun myeot madippun. daebak, saranghaeyo, hwaiting…",
    "en": "All the Korean I know is a few words from dramas. Daebak, saranghaeyo, hwaiting…"
   },
   "image_brief": "좌석 화면에 한국 드라마가 흐릿하게 흐른다.",
   "image_url": "content/images/u00-tutorial/pre-2.webp",
   "audio_url": ""
  },
  {
   "index": 3,
   "kind": "pre",
   "cut_kind": "narration",
   "narration": {
    "ko": "눈을 감는다. 비 오는 골목에서 누군가 우산을 내민다.",
    "roman": "nuneul gamneunda. bi oneun golmogeseo nugunga usaneul naeminda.",
    "en": "Eyes close. In a rainy alley, someone holds out an umbrella."
   },
   "image_brief": "비 오는 골목. 우산을 내민 손만 보인다.",
   "image_url": "content/images/u00-tutorial/pre-3.webp",
   "audio_url": ""
  },
  {
   "index": 4,
   "kind": "pre",
   "cut_kind": "narration",
   "narration": {
    "ko": "밤의 강에 불빛이 흔들린다. 다리 위로 도시의 불빛이 길게 번진다.",
    "roman": "bamui gange bulbichi heundeullinda. dari wiro dosiui bulbichi gilge beonjinda.",
    "en": "Lights tremble on the river at night. The city's lights stretch long across the bridges."
   },
   "image_brief": "꿈처럼 번지는 한강의 밤. 불 켜진 다리와 도시 야경.",
   "image_url": "content/images/u00-tutorial/pre-4.webp",
   "audio_url": ""
  },
  {
   "index": 5,
   "kind": "pre",
   "cut_kind": "speech",
   "speaker": "누군가",
   "line": {
    "ko": "다음에 또…",
    "roman": "daeume tto…",
    "en": "Next time…"
   },
   "aside": {
    "ko": "걸음을 멈추고 웃으며",
    "roman": "georeumeul meomchugo useumyeo",
    "en": "Stopping and smiling."
   },
   "image_brief": "저녁 골목에서 누군가 걸음을 멈추고 이쪽을 보며 웃는다. 가장자리는 꿈처럼 번진다.",
   "image_url": "content/images/u00-tutorial/pre-5.webp",
   "audio_url": ""
  },
  {
   "index": 6,
   "kind": "pre",
   "cut_kind": "speech",
   "speaker": "승무원",
   "line": {
    "ko": "안녕하세요! 한국은 처음이세요?",
    "roman": "annyeonghaseyo! hangugeun cheoeumiseyo?",
    "en": "Hello! Is this your first time in Korea?"
   },
   "aside": {
    "ko": "몸을 살짝 숙여 눈을 맞추며",
    "roman": "momeul saljjak sugyeo nuneul matchumyeo",
    "en": "Leaning in to meet your eyes."
   },
   "image_brief": "기체가 살짝 흔들린다. 눈을 뜨자 통로의 승무원이 빈 옆자리 너머로 몸을 숙여 손을 내밀며 이쪽을 본다.",
   "image_url": "content/images/u00-tutorial/pre-6.webp",
   "audio_url": ""
  }
 ],
