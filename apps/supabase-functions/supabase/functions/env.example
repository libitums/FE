# Supabase Edge Function(chat-send · companion-proactive · companion-eval · revenuecat-webhook)의 비밀 값. 이 파일은 이름만 담은 견본이다.
#
# 로컬:  cp env.example .env 로 복사해 값을 채운다(.env는 커밋되지 않는다 — 루트 .gitignore).
#        `supabase functions serve`가 이 폴더의 .env를 읽는다.
# 운영:  supabase secrets set --env-file supabase/functions/.env  (또는 대시보드 Edge Functions → Secrets)
# SUPABASE_URL · SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY는 Edge 런타임이 넣어 주므로 여기 적지 않는다.

# Claude API 키(컴패니언 전용으로 발급 — 원가 분리). COMPANION_LLM=anthropic일 때 필수.
ANTHROPIC_API_KEY=

# anthropic(실제 모델) 또는 fake(키 없이 정해진 답 — 화면 확인용). 키를 넣었으면 anthropic으로 바꾼다.
COMPANION_LLM=fake

# 비워 두면 claude-opus-5-5. 답변 모델.
COMPANION_MODEL=
# 검사 · 기억 추출 · 요약 모델. 비워 두면 COMPANION_MODEL.
COMPANION_MODERATION_MODEL=
# 피드백(교정) 모델. 비워 두면 COMPANION_MODERATION_MODEL(2026-11-10부터 — 전에는 COMPANION_MODEL).
COMPANION_FEEDBACK_MODEL=
# 캐릭터 답의 학습자 언어 번역. every(기본, 턴마다) 또는 off.
COMPANION_TRANSLATION=
# 번역 모델. 비워 두면 COMPANION_MODERATION_MODEL.
COMPANION_TRANSLATION_MODEL=
# 추천 답변 칩 모델(chat-send의 매 턴 자동 칩 · companion-suggest 다시 만들기). 비워 두면 COMPANION_MODERATION_MODEL.
COMPANION_SUGGEST_MODEL=

# RevenueCat 웹훅(revenuecat-webhook, ADR-0144). RevenueCat 대시보드 Webhook의 「Authorization header value」와 같은 문자열.
REVENUECAT_WEBHOOK_AUTH=
# 샌드박스 이벤트도 DB에 반영하는가 — 개발(QA) 프로젝트만 true. 운영은 비워 둔다(샌드박스는 200 sandbox_ignored).
REVENUECAT_ACCEPT_SANDBOX=
# 스냅샷 · 음성(companion-snapshot · companion-voice, ADR-0146). 비어 있으면 그 기능이 503 not_configured.
# 스냅샷 = ANTHROPIC_API_KEY(프롬프트 · 검사 노드) + OPENAI_API_KEY(이미지 편집). 음성 = ELEVENLABS_API_KEY.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# 프롬프트 · 검사 노드 모델. 비워 두면 claude-haiku-5-5.
COMPANION_SNAPSHOT_MODEL=
