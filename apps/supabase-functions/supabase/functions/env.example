# Supabase Edge Function(chat-send · companion-proactive · companion-eval · revenuecat-webhook)의 비밀 값. 이 파일은 이름만 담은 견본이다.
#
# 로컬:  cp env.example .env 로 복사해 값을 채운다(.env는 커밋되지 않는다 — 루트 .gitignore).
#        `supabase functions serve`가 이 폴더의 .env를 읽는다.
# 운영:  supabase secrets set --env-file supabase/functions/.env  (또는 대시보드 Edge Functions → Secrets)
# SUPABASE_URL · SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY는 Edge 런타임이 넣어 주므로 여기 적지 않는다.

# Claude API 키(컴패니언 전용으로 발급 — 원가 분리). COMPANION_LLM=anthropic일 때 필수.
ANTHROPIC_API_KEY=

# anthropic(실제 모델) 또는 fake(키 없이 정해진 답 — 화면 확인용). 키를 넣었으면 anthropic으로 바꾼다.
COMPANION_LLM=fake

# 비워 두면 claude-opus-5-5. 답변 모델.
COMPANION_MODEL=
# 답변의 생각 깊이. low(기본) 또는 medium.
COMPANION_REPLY_EFFORT=
# 검사 · 기억 추출 · 요약 모델. 비워 두면 COMPANION_MODEL.
COMPANION_MODERATION_MODEL=
# 피드백(교정) 모델. 비워 두면 COMPANION_MODERATION_MODEL(2026-11-10부터 — 전에는 COMPANION_MODEL).
COMPANION_FEEDBACK_MODEL=
# 캐릭터 답의 학습자 언어 번역. every(기본, 턴마다) 또는 off.
COMPANION_TRANSLATION=
# 번역 모델. 비워 두면 COMPANION_MODERATION_MODEL.
COMPANION_TRANSLATION_MODEL=
# 추천 답변 칩 모델(chat-send의 매 턴 자동 칩 · companion-suggest 다시 만들기). 비워 두면 COMPANION_MODERATION_MODEL.
COMPANION_SUGGEST_MODEL=
# 롤플레이 미션(ADR-0193) 모델 id — 컴패니언의 모델 설정(COMPANION_MODEL · COMPANION_FEEDBACK_MODEL · COMPANION_SUGGEST_MODEL)을
# 물려받지 않는다. 미션 턴의 검사 · 번역은 COMPANION_MODERATION_MODEL · COMPANION_TRANSLATION_MODEL을 그대로 쓴다.
# 상대역 답 모델. 비워 두면 claude-haiku-5-5(2026-11-23 — ADR-0193 D10).
COMPANION_MISSION_MODEL=
# 턴마다의 목표 판정 모델(답 · 교정과 병렬, ADR-0193 D12). 비워 두면 claude-haiku-5-5.
COMPANION_MISSION_JUDGE_MODEL=
# 채점 모델. 비워 두면 claude-sonnet-5-5.
COMPANION_MISSION_GRADER_MODEL=
# 교정 모델. 비워 두면 claude-haiku-5-5.
COMPANION_MISSION_FEEDBACK_MODEL=
# 힌트 모델. 비워 두면 claude-haiku-5-5.
COMPANION_MISSION_HINT_MODEL=
# 미션 음성(mission-stt · mission-tts). 키는 1단계 음성과 같은 ELEVENLABS_API_KEY(아래)를 읽는다 — 비어 있으면 503 voice_not_configured.
# 받아 적기 모델. 비워 두면 scribe_v3.
COMPANION_MISSION_STT_MODEL=
# 합성 모델. 비워 두면 eleven_v4_turbo.
COMPANION_MISSION_TTS_MODEL=
# 미션 파일에 counterpart.voice가 없을 때 쓰는 ElevenLabs 음성 id. 비워 두면 l6fNdLYgoqjfTIPUeFc9(실험실 기본 — 편의점 점원).
COMPANION_MISSION_TTS_VOICE=
# Scribe 요청에 enable_logging=false(무보존 모드)를 싣는가. on이면 싣는다, 비워 두면 싣지 않음(벤더 보존은 처리방침에 적힌 범위에서 허용 —
# 2026-11-26 사용자 결정). 무보존은 ElevenLabs 엔터프라이즈 계정일 때 켤 수 있다. 우리 서버는 어느 쪽이든 녹음을 저장하지 않는다.
COMPANION_MISSION_STT_ZERO_RETENTION=
# 받아 적은 글을 바로 보낼 문턱(맥미니 실측 기본값). 낱말 확신도 최소 · 평균(0 ~ 1), 녹음 최소 초(0 ~ 5), 한글 비율(0 ~ 1).
COMPANION_MISSION_AUTOSEND_CONF_MIN=
COMPANION_MISSION_AUTOSEND_CONF_MEAN=
COMPANION_MISSION_AUTOSEND_MIN_SECONDS=
COMPANION_MISSION_AUTOSEND_HANGUL_MIN=
# 벤더가 확신도를 주지 않을 때 바로 보낼지. on이면 바로, 비워 두면 늘 확인(Scribe는 늘 확신도를 준다).
COMPANION_MISSION_AUTOSEND_WITHOUT_CONFIDENCE=
# 내 스토리 반응(companion-story-reactions, ADR-0191 D5)의 모델. 답은 비워 두면 claude-sonnet-5-5(대화의 COMPANION_MODEL과 따로),
# 출력 검사 · 번역은 비워 두면 claude-haiku-5-5, 칩은 비워 두면 COMPANION_SUGGEST_MODEL → claude-haiku-5-5.
COMPANION_REACTION_MODEL=
COMPANION_REACTION_CHECK_MODEL=
COMPANION_REACTION_TRANSLATION_MODEL=
COMPANION_REACTION_SUGGEST_MODEL=
# 사진 스토리의 읽기 단계(companion-my-story · companion-story-reactions의 다시 보기, ADR-0191 D11) 모델. 비워 두면 claude-sonnet-5-5.
COMPANION_STORY_READ_MODEL=

# RevenueCat 웹훅(revenuecat-webhook, ADR-0144). RevenueCat 대시보드 Webhook의 「Authorization header value」와 같은 문자열.
REVENUECAT_WEBHOOK_AUTH=
# 샌드박스 이벤트도 DB에 반영하는가 — 개발(QA) 프로젝트만 true. 운영은 비워 둔다(샌드박스는 200 sandbox_ignored).
REVENUECAT_ACCEPT_SANDBOX=
# 스냅샷 · 음성(companion-snapshot · companion-voice, ADR-0146). 비어 있으면 그 기능이 503 not_configured.
# 스냅샷 = ANTHROPIC_API_KEY(프롬프트 · 검사 노드) + OPENAI_API_KEY(이미지 편집). 음성 = ELEVENLABS_API_KEY(미션 음성도 같은 키).
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# 프롬프트 · 검사 노드 모델. 비워 두면 claude-haiku-5-5.
COMPANION_SNAPSHOT_MODEL=
# 검사 노드(그린 그림을 Claude 비전으로 한 번 더 보기). on이면 켠다. 비워 두면 끔(ADR-0152 — 한 장에 걸리는 시간을 줄인다).
COMPANION_SNAPSHOT_CHECK=
# 이미지 엔진에서 받을 중간 그림 수(0 ~ 3). 비워 두면 0(끔 — 지금 편집 · Flare 조합에서는 중간 그림이 오지 않았다). 켜면 한 장 약 $0.003.
COMPANION_SNAPSHOT_PARTIAL_IMAGES=
# 기준 그림. 비워 두면 all(시트 + 표정 시트), sheet면 시트 한 장만(입력 토큰 — 사진 원가의 약 2/3 — 를 줄인다).
COMPANION_SNAPSHOT_REFS=
# 이미지 엔진 complexity(low · medium · high). 비워 두면 보내지 않음 — gpt-image-2.5-flare는 이 값을 받지 않는다(400). 2.6에서만 넣는다.
COMPANION_SNAPSHOT_COMPLEXITY=
# 스냅샷 방식(ADR-0179). 비워 두면 v1. v2m = 장면 설계 + 미리 합친 기준 그림(모두), v2m-test = 시험 계정만 v2m.
# 인물 묶음(companion-refs/v2/<slug>/manifest.json)이 없으면 그 인물은 v1으로 그린다.
COMPANION_SNAPSHOT_PIPELINE=
