# AI 컴패니언 Edge Function(chat-send · companion-proactive)의 비밀 값. 이 파일은 이름만 담은 견본이다.
#
# 로컬:  cp env.example .env 로 복사해 값을 채운다(.env는 커밋되지 않는다 — 루트 .gitignore).
#        `supabase functions serve`가 이 폴더의 .env를 읽는다.
# 운영:  supabase secrets set --env-file supabase/functions/.env  (또는 대시보드 Edge Functions → Secrets)
# SUPABASE_URL · SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY는 Edge 런타임이 넣어 주므로 여기 적지 않는다.

# Claude API 키(컴패니언 전용으로 발급 — 원가 분리). COMPANION_LLM=anthropic일 때 필수.
ANTHROPIC_API_KEY=

# anthropic(실제 모델) 또는 fake(키 없이 정해진 답 — 화면 확인용). 키를 넣었으면 anthropic으로 바꾼다.
COMPANION_LLM=fake

# 비워 두면 claude-opus-5-5. 검사 · 피드백 · 기억 모델을 따로 쓰려면 COMPANION_MODERATION_MODEL.
COMPANION_MODEL=
COMPANION_MODERATION_MODEL=
