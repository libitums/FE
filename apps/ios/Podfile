source 'https://cdn.cocoapods.org/'

platform :ios, '17.4'

# Lynx SDK는 정확 버전으로 고정한다 (ADR-0012 D4). 하한은 3.9.
# 4.0.1을 쓰는 이유: 개발 루프의 Lynx Explorer도 4.0.1이라 두 환경의 런타임이 같다.
LYNX_VERSION = '4.0.1'

target 'Host' do
  pod 'Lynx', LYNX_VERSION, :subspecs => ['Framework']

  # Lynx 4.0.1의 Framework subspec이 PrimJS/quickjs 4.0.0을 못 박는다.
  pod 'PrimJS', '4.0.0', :subspecs => ['quickjs', 'napi']

  # 이미지·로그·네트워크 서비스. Http가 없으면 앱에서 fetch가 돌지 않는다 (ADR-0007 D2).
  # 4.0.1 소스는 유지하고 Image의 SDWebImage 버전 제약만 조정한다. podspecs/README.md 참조.
  pod 'LynxService', :podspec => 'podspecs/LynxService.podspec.json', :subspecs => ['Image', 'Log', 'Http']

  # 공식 SDK Privacy Manifest를 리소스 번들로 포함하는 버전이다.
  pod 'SDWebImage', '5.21.7'
  pod 'SDWebImageWebPCoder', '0.11.0'

  pod 'XElement', LYNX_VERSION

  # Airbridge 앱 이벤트 측정용 SDK 하나만 둔다(ADR-0063 · ADR-0079). 일반판 — 사용자가 추적을 허용하면 IDFA를 싣는다.
  # 정확 버전이다(ADR-0012 D4). restricted 변형과 함께 설치하지 않는다.
  pod 'airbridge-ios-sdk', '4.12.0'

  target 'HostTests' do
    inherit! :search_paths
  end
end
