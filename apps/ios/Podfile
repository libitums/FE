source 'https://cdn.cocoapods.org/'

platform :ios, '17.4'

# Lynx SDK는 정확 버전으로 고정한다 (ADR-0012 D4). 하한은 3.9.
# 4.0.1을 쓰는 이유: 개발 루프의 Lynx Explorer도 4.0.1이라 두 환경의 런타임이 같다.
LYNX_VERSION = '4.0.1'

target 'Host' do
  pod 'Lynx', LYNX_VERSION, :subspecs => ['Framework']

  # Lynx 4.0.1의 Framework subspec이 PrimJS/quickjs 4.0.0을 못 박는다.
  pod 'PrimJS', '4.0.0', :subspecs => ['quickjs', 'napi']

  # 이미지·로그·네트워크 서비스. Http가 없으면 앱에서 fetch가 돌지 않는다 (ADR-0007 D2).
  pod 'LynxService', LYNX_VERSION, :subspecs => ['Image', 'Log', 'Http']

  # LynxService/Image가 요구한다.
  pod 'SDWebImage', '5.15.5'
  pod 'SDWebImageWebPCoder', '0.11.0'

  pod 'XElement', LYNX_VERSION
end
