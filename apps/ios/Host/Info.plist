<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Duru</string>
	<!-- Airbridge 앱 이벤트 SDK(ADR-0063). 앱 이름 · SDK 토큰은 Config/Airbridge.xcconfig에서 들어온다.
	     SDK가 읽는 키가 아니라 호스트 코드(AirbridgeEventsConfig)가 읽는다. 비어 있으면 SDK를 시작하지 않는다.
	     SKAdNetworkItems는 두지 않는다(광고를 보여 주는 앱의 키다). -->
	<key>AirbridgeAppName</key>
	<string>$(AIRBRIDGE_APP_NAME)</string>
	<key>AirbridgeSDKToken</key>
	<string>$(AIRBRIDGE_SDK_TOKEN)</string>
	<!-- 추적 허용(ATT) 대화상자의 문구(ADR-0079 D4 — 사용자 결정 2026-10-22). 가입을 마친 뒤 여정 맵에 들어설 때
	     아직 정하지 않았으면 한 번 묻는다. 앱 언어가 영어라 영어 한 줄이다. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Allow tracking so we can measure which ads helped you find Duru. We never sell your data.</string>
	<!-- dev 서버가 localhost 평문 HTTP다. 임의 HTTP를 여는 NSAllowsArbitraryLoads가
	     아니라 로컬 네트워킹만 여는 좁은 키를 쓴다 (ADR-0012 D2). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Accent family(design-tokens 0.3.0 `font.family.accent`)의 Jost를 앱 번들에서 등록한다.
	     design-system foundations/font-delivery.md가 고정한 google/fonts 배포물 그대로(파일명만 바꿈). -->
	<key>UIAppFonts</key>
	<array>
		<string>fonts/Jost.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
