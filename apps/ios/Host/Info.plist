<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Duru</string>
	<!-- Airbridge 앱 이벤트 SDK(ADR-0063). 앱 이름 · SDK 토큰은 Config/Airbridge.xcconfig에서 들어온다.
	     SDK가 읽는 키가 아니라 호스트 코드(AirbridgeEventsConfig)가 읽는다. 비어 있으면 SDK를 시작하지 않는다.
	     SKAdNetworkItems는 아래 AdMob 보상형 광고(ADR-0208) 몫이다 — Airbridge가 요구하는 키가 아니다. -->
	<key>AirbridgeAppName</key>
	<string>$(AIRBRIDGE_APP_NAME)</string>
	<key>AirbridgeSDKToken</key>
	<string>$(AIRBRIDGE_SDK_TOKEN)</string>
	<!-- RevenueCat 구매 SDK(ADR-0144 2단계). 공개 SDK 키는 Config/RevenueCat.xcconfig에서 들어온다. 호스트 코드(PurchasesConfig)가 읽고,
	     비어 있으면 SDK를 시작하지 않고 구매 모듈도 등록하지 않는다. -->
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<!-- Sentry 오류 수집(ADR-0207). DSN · environment는 Config/Sentry.xcconfig에서 들어온다. 호스트 코드(CrashReportConfig)가 읽고,
	     DSN이 비거나 꼴이 틀리면 SDK를 시작하지 않는다. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SentryEnvironment</key>
	<string>$(SENTRY_ENVIRONMENT)</string>
	<!-- Google Mobile Ads(AdMob) 보상형 광고(ADR-0208). 앱 ID · 광고 단위는 Config/AdMob.xcconfig에서 들어온다. 앱 ID는 늘 차 있어야 한다
	     (비면 SDK가 앱이 뜰 때 죽인다 — 기본값은 Google 샘플 앱 ID). 광고 단위가 비면 호스트 코드(RewardedAdConfig)가 SDK를 시작하지 않고
	     광고 모듈도 등록하지 않는다. 광고는 비개인화(npa=1)로 요청하고 ATT를 새로 묻지 않는다. SDK의 측정 초기화는 시작할 때까지 미룬다. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<key>GADDelayAppMeasurementInit</key>
	<true/>
	<key>AdMobRewardedUnitID</key>
	<string>$(ADMOB_REWARDED_UNIT_ID)</string>
