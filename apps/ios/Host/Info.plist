	<!-- 추적 허용(ATT) 대화상자의 문구(ADR-0079 D4 — 사용자 결정 2026-10-22). 가입을 마친 뒤 여정 맵에 들어설 때
	     아직 정하지 않았으면 한 번 묻는다. 앱 언어가 영어라 영어 한 줄이다. -->
	<!-- Airbridge 딥링크의 앱 scheme(ADR-0080). `duru://journey` · `duru://roleplay` · `duru://settings`를 JS가 탭으로 옮긴다.
	     로그인 콜백 `duru://auth-callback`은 웹 인증 세션이 받으므로 딥링크로 다루지 않는다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.libitum.host</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>duru</string>
			</array>
		</dict>
	</array>
	<key>NSUserTrackingUsageDescription</key>
	<string>Allow tracking so we can measure which ads helped you find Duru. We never sell your data.</string>
	<!-- dev 서버가 localhost 평문 HTTP다. 임의 HTTP를 여는 NSAllowsArbitraryLoads가
	     아니라 로컬 네트워킹만 여는 좁은 키를 쓴다 (ADR-0012 D2). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Accent family(design-tokens 0.3.0 `font.family.accent`)의 Jost를 앱 번들에서 등록한다.
	     design-system foundations/font-delivery.md가 고정한 google/fonts 배포물 그대로(파일명만 바꿈). -->
	<key>UIAppFonts</key>
	<array>
		<string>fonts/Jost.ttf</string>
		<!-- UI 언어가 베트남어일 때만 쓰는 강조 글꼴(ADR-0091 D5). Jost에 베트남어 글자가 없다. -->
		<string>fonts/LeagueSpartan.ttf</string>
		<!-- 본문 글꼴 Duru Sans(Pretendard JP 서브셋)와 로마자 기울임 글꼴 Duru Roman(Inter Italic 서브셋) — ADR-0107. -->
		<string>fonts/DuruSans.ttf</string>
		<string>fonts/DuruRoman.ttf</string>
	</array>
